---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  SITE_NAME,
  CATEGORY_DESCRIPTIONS,
  CATEGORY_DESCRIPTION_FALLBACK,
} from '../../consts';
import { withBase } from '../../lib/url';
import { readingMinutes } from '../../lib/reading';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const categories = [...new Set(posts.map((p) => p.data.category))];
  return categories.map((category) => ({
    params: { name: category },
    props: {
      category,
      posts: posts
        .filter((p) => p.data.category === category)
        .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()),
    },
  }));
}

const { category, posts } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL(withBase('/'), Astro.site).href;

// 허브별 설명. 손으로 쓴 것이 있으면 그걸 쓰고, 없는 카테고리는 템플릿으로 떨어진다.
const metaDescription =
  CATEGORY_DESCRIPTIONS[category] ?? CATEGORY_DESCRIPTION_FALLBACK(category);

// 이 카테고리에 속한 글을 ItemList로 노출(홈과 동일 패턴) — 검색엔진이
// 허브 페이지가 어떤 글을 묶는지 구조로 이해. 최신순, position 1부터.
const listItems = posts.map((post, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  url: new URL(withBase(`/posts/${post.id}/`), Astro.site).href,
  name: post.data.title,
}));

// CollectionPage + ItemList + BreadcrumbList (@graph)
// — 검색결과 경로(빵부스러기) 표시 + 허브가 묶는 글 목록 노출
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: `${category} — ${SITE_NAME}`,
      description: metaDescription,
      url: canonical.href,
      inLanguage: 'ko-KR',
      publisher: { '@type': 'Organization', name: SITE_NAME },
    },
    {
      '@type': 'ItemList',
      name: `${category} 글 목록`,
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
      numberOfItems: listItems.length,
      itemListElement: listItems,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE_NAME, item: siteUrl },
        { '@type': 'ListItem', position: 2, name: category, item: canonical.href },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${category} — 옳은경제`}
  description={metaDescription}
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <nav class="breadcrumb" aria-label="breadcrumb">
    <ol>
      <li><a href={withBase('/')}>{SITE_NAME}</a></li>
      <li><span aria-current="page">{category}</span></li>
    </ol>
  </nav>

  <div class="category-hero">
    <span class="category">{category}</span>
    <h1>{category}</h1>
    <p class="count">글 {posts.length}편</p>
  </div>

  <ul class="card-list">
    {posts.map((post) => (
      <li>
        <a class="card" href={withBase(`/posts/${post.id}/`)}>
          <span class="category">{post.data.category}</span>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <div class="card-meta">
            <time datetime={post.data.publishedDate.toISOString().slice(0, 10)}>
              {post.data.publishedDate.toLocaleDateString('ko-KR')}
            </time>
            <span aria-hidden="true">·</span>
            <span>📖 약 {readingMinutes(post.body)}분</span>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <a class="back-link" href={withBase('/')}>← 전체 글 보기</a>
</BaseLayout>

<style>
  .category-hero {
    margin: 28px 0 4px;
    text-align: center;
  }
  .category-hero h1 {
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 10px 0 4px;
    color: var(--ink);
  }
  .count {
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0 0 8px;
  }
</style>
