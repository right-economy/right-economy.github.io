---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME } from '../consts';
import { withBase } from '../lib/url';
import { organizationNode } from '../lib/schema';

const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL(withBase('/'), Astro.site).href;

// AboutPage + Organization(발행처) + BreadcrumbList (@graph)
// — 글 상세의 Article.publisher가 가리키는 발행 주체를 /about에 정식 노드로
//   명시해, 검색엔진이 사이트를 하나의 엔티티(지식 그래프)로 이해하게 한다.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationNode(Astro.site),
    {
      '@type': 'AboutPage',
      name: `소개 — ${SITE_NAME}`,
      url: canonical.href,
      inLanguage: 'ko-KR',
      about: { '@id': `${siteUrl}#organization` },
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE_NAME, item: siteUrl },
        { '@type': 'ListItem', position: 2, name: '소개', item: canonical.href },
      ],
    },
  ],
};
---

<BaseLayout
  title={`소개 — ${SITE_NAME}`}
  description={`${SITE_NAME}는 복잡한 경제를 쉽고 정확하게, 바른 방향으로 정리하는 콘텐츠 사이트입니다.`}
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <nav class="breadcrumb" aria-label="breadcrumb">
    <ol>
      <li><a href={withBase('/')}>{SITE_NAME}</a></li>
      <li><span aria-current="page">소개</span></li>
    </ol>
  </nav>

  <article class="post">
    <h1>옳은경제 소개</h1>

    <p>
      <strong>옳은경제</strong>는 복잡하고 어려운 경제를 누구나 이해할 수 있도록
      <strong>쉽고 정확하게</strong> 정리하는 콘텐츠 사이트입니다. 🧭
    </p>

    <h2>무엇을 다루나요</h2>
    <ul>
      <li>금리·물가·환율·GDP 등 <strong>경제 기초 개념</strong></li>
      <li>주식·ETF·배당 등 <strong>투자의 기본</strong></li>
      <li>연말정산·4대 보험·연금 등 <strong>생활 속 경제</strong></li>
      <li>매일의 시장 흐름을 짚는 <strong>데일리 시황</strong></li>
    </ul>

    <h2>우리가 지키는 것</h2>
    <p>
      뉴스와 숫자에 휘둘리지 않도록, 화려한 전망보다 <strong>원리와 맥락</strong>을
      먼저 설명합니다. 어려운 용어는 일상의 비유로 풀고, 한쪽으로 치우치지 않은
      균형 잡힌 시선을 지향합니다.
    </p>

    <h2>면책 안내</h2>
    <p>
      본 사이트의 모든 콘텐츠는 <strong>정보 제공을 목적</strong>으로 하며, 특정
      종목이나 상품의 매수·매도를 권유하지 않습니다. 투자의 최종 판단과 책임은
      이용자 본인에게 있습니다.
    </p>

    <h2>운영 및 문의</h2>
    <p>
      운영: 글린트프로젝트<br />
      문의: <a href={withBase('/contact/')}>문의하기</a> 페이지에서 연락 주세요.
    </p>

    <a class="back-link" href={withBase('/')}>← 홈으로</a>
  </article>
</BaseLayout>
