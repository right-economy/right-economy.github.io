---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME } from '../../consts';
import { withBase } from '../../lib/url';
import { organizationNode, orgId as orgIdOf } from '../../lib/schema';
import { readingMinutes } from '../../lib/reading';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const published = post.data.publishedDate;
const dateLabel = published.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// 읽기 시간 추정 (공용 헬퍼 — 목록 카드와 같은 공식 사용)
const minutes = readingMinutes(post.body);

const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL(withBase('/'), Astro.site).href;
const ogImage = new URL(withBase('/og-default.png'), Astro.site).href;

// Article 구조화 데이터 보강용: 글자 수 + ISO 8601 읽기 시간(PT#M)
const wordCount = [...(post.body ?? '').replace(/[#>*`|_\-\[\]()!]/g, '')].length;
const timeRequired = `PT${minutes}M`;

// 관련 글: 태그 겹침을 우선 신호로 관련도를 점수화한다.
// 겹치는 태그(가중치 2) + 같은 카테고리(가중치 1), 동점은 최신순. 현재 글 제외, 최대 3개.
// 태그가 하나도 안 겹치면 기존 동작(같은 카테고리 최신순)으로 자연스럽게 수렴한다.
const currentTags = new Set(post.data.tags ?? []);
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => {
    const sharedTags = (p.data.tags ?? []).filter((t) => currentTags.has(t)).length;
    const sameCategory = p.data.category === post.data.category ? 1 : 0;
    return { post: p, score: sharedTags * 2 + sameCategory };
  })
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.post.data.publishedDate.getTime() - a.post.data.publishedDate.getTime()
  )
  .slice(0, 3)
  .map((x) => x.post);

// 이전/다음 글: 전체 글을 발행일 최신순으로 줄세워 양옆 글 찾기 (순차 읽기 + 내부 링크)
const chrono = [...allPosts].sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);
const idx = chrono.findIndex((p) => p.id === post.id);
const newerPost = idx > 0 ? chrono[idx - 1] : null; // 더 최신 = 다음 글
const olderPost = idx >= 0 && idx < chrono.length - 1 ? chrono[idx + 1] : null; // 더 예전 = 이전 글

// 카테고리명 → URL 슬러그 변환 (한글 포함 URL 안전)
const categorySlug = encodeURIComponent(post.data.category);
const categoryUrl = new URL(withBase(`/category/${categorySlug}/`), Astro.site).href;

// 검색결과 리치 표시용 구조화 데이터: Organization + Article + BreadcrumbList (@graph)
// 발행 주체를 홈페이지와 같은 @id(#organization)로 참조 → 검색엔진이 사이트 전체를
// 단일 발행 엔티티로 통합 인식(E-E-A-T 신호). author·publisher가 같은 노드를 가리킨다.
const orgId = orgIdOf(Astro.site);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationNode(Astro.site),
    {
      '@type': 'Article',
      headline: post.data.title,
      description: post.data.description,
      image: [ogImage],
      datePublished: published.toISOString(),
      dateModified: published.toISOString(),
      inLanguage: 'ko-KR',
      articleSection: post.data.category,
      keywords: post.data.tags?.join(', ') || undefined,
      wordCount,
      timeRequired,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
      author: { '@id': orgId },
      publisher: { '@id': orgId },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE_NAME, item: siteUrl },
        { '@type': 'ListItem', position: 2, name: post.data.category, item: categoryUrl },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical.href },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${post.data.title} — 옳은경제`}
  description={post.data.description}
  ogType="article"
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />
  {/* Open Graph article 메타 (소셜 공유·검색 리치) */}
  <meta property="article:published_time" content={published.toISOString()} slot="head" />
  <meta property="article:section" content={post.data.category} slot="head" />
  {/* 글의 주제 태그를 OG article:tag로 노출 — 소셜·검색이 글의 토픽을 구조로 이해 */}
  {post.data.tags?.map((tag: string) => (
    <meta property="article:tag" content={tag} slot="head" />
  ))}
  {/* 순차 읽기 힌트: 크롤러·리더가 이전/다음 글 관계를 이해하도록
      rel=prev(더 예전 글)·rel=next(더 최신 글) 링크를 head에 명시.
      화면의 이전/다음 내비게이션과 같은 대상을 가리킨다. */}
  {olderPost && (
    <link
      rel="prev"
      href={new URL(withBase(`/posts/${olderPost.id}/`), Astro.site).href}
      slot="head"
    />
  )}
  {newerPost && (
    <link
      rel="next"
      href={new URL(withBase(`/posts/${newerPost.id}/`), Astro.site).href}
      slot="head"
    />
  )}
  <nav class="breadcrumb" aria-label="breadcrumb">
    <ol>
      <li><a href={withBase('/')}>{SITE_NAME}</a></li>
      <li><a href={withBase(`/category/${categorySlug}/`)}>{post.data.category}</a></li>
      <li><span aria-current="page">{post.data.title}</span></li>
    </ol>
  </nav>
  <article class="post">
    <a class="category" href={withBase(`/category/${post.data.category}/`)}>{post.data.category}</a>
    <h1>{post.data.title}</h1>
    <p class="meta">
      <time datetime={published.toISOString().slice(0, 10)}>{dateLabel}</time>
      <span class="reading-time"> · 📖 약 {minutes}분</span>
    </p>

    <Content />

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="tag-list" role="list" aria-label="태그">
        {post.data.tags.map((tag: string) => (
          <a class="tag-chip" href={withBase(`/tags/${tag}/`)} role="listitem">#{tag}</a>
        ))}
      </div>
    )}

    {/* 광고: AdSense 승인 후 Auto Ads가 자동 배치. 빈 placeholder 박스는
        심사·UX에 불리해 두지 않음. 필요 시 실제 광고 유닛으로 추가 예정. */}
  </article>

  {relatedPosts.length > 0 && (
    <section class="related-posts">
      <h2 class="related-posts__heading">관련 글</h2>
      <ul class="card-list">
        {relatedPosts.map((p) => (
          <li>
            <a class="card" href={withBase(`/posts/${p.id}/`)}>
              <span class="category">{p.data.category}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {(olderPost || newerPost) && (
    <nav class="post-nav" aria-label="이전·다음 글">
      {olderPost ? (
        <a class="post-nav__item post-nav__prev" href={withBase(`/posts/${olderPost.id}/`)}>
          <span class="post-nav__dir">← 이전 글</span>
          <span class="post-nav__title">{olderPost.data.title}</span>
        </a>
      ) : (
        <span class="post-nav__item post-nav__empty"></span>
      )}
      {newerPost ? (
        <a class="post-nav__item post-nav__next" href={withBase(`/posts/${newerPost.id}/`)}>
          <span class="post-nav__dir">다음 글 →</span>
          <span class="post-nav__title">{newerPost.data.title}</span>
        </a>
      ) : (
        <span class="post-nav__item post-nav__empty"></span>
      )}
    </nav>
  )}

  <a class="back-link" href={withBase('/')}>← 목록으로</a>
</BaseLayout>
