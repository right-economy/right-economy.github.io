---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_INSTAGRAM } from '../consts';
import { organizationNode } from '../lib/schema';
import { withBase } from '../lib/url';

const canonical = new URL(Astro.url.pathname, Astro.site);
const siteUrl = new URL(withBase('/'), Astro.site).href;

// 연락처 페이지. 운영 주체와 소통 창구를 명시해 신뢰(E-E-A-T)·광고 심사
// 신호를 보강한다. ContactPage + Organization 연결로 검색엔진이 발행 주체를
// 하나의 엔티티로 인식하게 한다.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    // publisher 가 가리키는 발행 주체. @id 참조는 같은 페이지의 JSON-LD 안에서만
    // 풀리므로, 참조만 두고 노드를 빠뜨리면 발행 주체가 빈 참조로 남는다.
    organizationNode(Astro.site),
    {
      '@type': 'ContactPage',
      name: `문의 — ${SITE_NAME}`,
      url: canonical.href,
      inLanguage: 'ko-KR',
      about: { '@id': `${siteUrl}#organization` },
      publisher: { '@id': `${siteUrl}#organization` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE_NAME, item: siteUrl },
        { '@type': 'ListItem', position: 2, name: '문의', item: canonical.href },
      ],
    },
  ],
};
---

<BaseLayout
  title={`문의 — ${SITE_NAME}`}
  description={`${SITE_NAME}에 궁금한 점이나 제휴·피드백을 남기고 싶다면 이곳으로 연락 주세요.`}
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <nav class="breadcrumb" aria-label="breadcrumb">
    <ol>
      <li><a href={withBase('/')}>{SITE_NAME}</a></li>
      <li><span aria-current="page">문의</span></li>
    </ol>
  </nav>

  <article class="post">
    <h1>문의하기</h1>

    <p>
      <strong>옳은경제</strong>를 찾아 주셔서 감사합니다. 콘텐츠에 대한 의견,
      정정 요청, 제휴·광고 문의 등 무엇이든 아래 창구로 편하게 연락 주세요. 🧭
    </p>

    <h2>연락 방법</h2>
    <ul>
      <li>
        <strong>인스타그램 DM</strong> —
        <a href={SITE_INSTAGRAM} target="_blank" rel="noopener">@right.economy</a>
        로 메시지를 보내 주시면 확인 후 답변드립니다.
      </li>
    </ul>

    <h2>이런 문의를 환영해요</h2>
    <ul>
      <li>콘텐츠의 <strong>오류 정정</strong> 및 사실 확인 요청</li>
      <li>다뤄줬으면 하는 <strong>주제 제안</strong></li>
      <li><strong>제휴·광고·인용</strong> 관련 협의</li>
      <li>기타 사이트 이용에 대한 피드백</li>
    </ul>

    <h2>안내</h2>
    <p>
      본 사이트의 콘텐츠는 정보 제공을 목적으로 하며 투자 권유가 아닙니다.
      개별 투자 상담이나 종목 추천 문의에는 답변드리기 어려운 점 양해 부탁드립니다.
      자세한 내용은 <a href={withBase('/disclaimer/')}>면책조항</a>을 참고해 주세요.
    </p>

    <p>
      운영: 글린트프로젝트
    </p>

    <a class="back-link" href={withBase('/')}>← 홈으로</a>
  </article>
</BaseLayout>
